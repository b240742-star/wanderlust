<style>
  .filters-sidebar {
    background: rgba(26, 26, 26, 0.95);
    border-radius: 10px;
    padding: 1.5rem;
    margin-bottom: 2rem;
    border: 1px solid rgba(255, 255, 255, 0.1);
    box-shadow: 0 4px 6px rgba(0, 0, 0, 0.3);
  }

  .filters-sidebar h4 {
    color: var(--primary-color);
    margin-bottom: 1rem;
    font-weight: 600;
  }

  .filter-section {
    margin-bottom: 1.5rem;
  }

  .filter-section label {
    color: #ffffff;
    font-weight: 500;
    margin-bottom: 0.5rem;
    display: block;
  }

  .filter-section input,
  .filter-section select {
    width: 100%;
    padding: 0.5rem;
    border: 1px solid rgba(255, 255, 255, 0.2);
    border-radius: 5px;
    background: rgba(255, 255, 255, 0.1);
    color: #ffffff;
    margin-bottom: 0.5rem;
  }

  .filter-section input::placeholder {
    color: rgba(255, 255, 255, 0.7);
  }

  .price-range {
    display: flex;
    gap: 0.5rem;
    align-items: center;
  }

  .price-range input {
    flex: 1;
  }

  .filter-btn {
    background: var(--primary-color);
    color: #ffffff;
    border: none;
    padding: 0.75rem 1.5rem;
    border-radius: 5px;
    cursor: pointer;
    font-weight: 600;
    width: 100%;
    transition: all 0.3s ease;
  }

  .filter-btn:hover {
    background: var(--secondary-color);
    transform: translateY(-1px);
  }

  .clear-filters {
    background: transparent;
    color: var(--primary-color);
    border: 1px solid var(--primary-color);
    margin-top: 0.5rem;
  }

  .clear-filters:hover {
    background: var(--primary-color);
    color: #ffffff;
  }

  .category-checkboxes {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .category-checkboxes label {
    display: flex;
    align-items: center;
    gap: 0.25rem;
    background: rgba(255, 255, 255, 0.1);
    padding: 0.25rem 0.5rem;
    border-radius: 3px;
    cursor: pointer;
    font-size: 0.9rem;
  }

  .category-checkboxes input[type="checkbox"] {
    width: auto;
    margin: 0;
  }
</style>

<div class="filters-sidebar">
  <h4><i class="fa-solid fa-filter"></i> Filters</h4>

  <form action="/listings" method="GET" id="filterForm">
    <!-- Price Range -->
    <div class="filter-section">
      <label for="price_min">Price Range (₹)</label>
      <div class="price-range">
        <input type="number" id="price_min" name="price_min" placeholder="Min" min="0">
        <span style="color: #ffffff;">-</span>
        <input type="number" id="price_max" name="price_max" placeholder="Max" min="0">
      </div>
    </div>

    <!-- Location -->
    <div class="filter-section">
      <label for="location">Location</label>
      <input type="text" id="location" name="location" placeholder="Enter location">
    </div>

    <!-- Country -->
    <div class="filter-section">
      <label for="country">Country</label>
      <input type="text" id="country" name="country" placeholder="Enter country">
    </div>

    <!-- Categories -->
    <div class="filter-section">
      <label>Categories</label>
      <div class="category-checkboxes">
        <label><input type="checkbox" name="category" value="Trending"> Trending</label>
        <label><input type="checkbox" name="category" value="Iconic cities"> Iconic Cities</label>
        <label><input type="checkbox" name="category" value="Mountains"> Mountains</label>
        <label><input type="checkbox" name="category" value="Castles"> Castles</label>
        <label><input type="checkbox" name="category" value="Amazing pools"> Amazing Pools</label>
        <label><input type="checkbox" name="category" value="Rooms"> Rooms</label>
        <label><input type="checkbox" name="category" value="Camping"> Camping</label>
        <label><input type="checkbox" name="category" value="Farms"> Farms</label>
        <label><input type="checkbox" name="category" value="Arctic"> Arctic</label>
        <label><input type="checkbox" name="category" value="Domes"> Domes</label>
        <label><input type="checkbox" name="category" value="Boats"> Boats</label>
      </div>
    </div>

    <input type="submit" value="Apply Filters" class="filter-btn">
    <button type="button" class="filter-btn clear-filters" onclick="clearFilters()">Clear Filters</button>
  </form>
</div>

<script>
  function clearFilters() {
    document.getElementById('filterForm').reset();
    window.location.href = '/listings';
  }
</script>