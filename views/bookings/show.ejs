<% layout("/layouts/boilerplate") %>
<div class="row mt-3">
    <div class="col-sm-8 offset-sm-2">
        <div class="booking-card">
            <h3>Booking Confirmed!</h3>
            <p><b>Listing:</b> <%= booking.listing.title %></p>
            <p><b>Check-in:</b> <%= booking.checkIn.toDateString() %></p>
            <p><b>Check-out:</b> <%= booking.checkOut.toDateString() %></p>
            <p><b>Guests:</b> <%= booking.guests %></p>
            <p><b>Total Price:</b> &#8377; <%= booking.totalPrice.toLocaleString("en-IN") %></p>
            <a href="/bookings" class="book-btn" style="display:inline-block; text-decoration:none; width:auto; padding:0 20px;">Back to My Bookings</a>
        </div>
    </div>
</div>